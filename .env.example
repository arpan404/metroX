METROX_DATABASE_URL=postgresql+psycopg://metrox:metrox@localhost:5432/metrox
METROX_API_KEY=local-dev-key
METROX_REDIS_URL=redis://localhost:6379/0
METROX_ALLOW_SYNTHETIC_TARGETS=true
METROX_USE_MIGRATIONS=false
METROX_SECRET_ACTIVE_KEY_VERSION=v1
# JSON map of key versions -> key material. Example: {"v1":"local-dev-secret","v2":"rotated-secret"}
METROX_SECRET_KEYS_JSON=
METROX_SECRET_BACKEND=local
METROX_SECRET_BACKEND_STRICT=false
METROX_AWS_KMS_KEY_ID=
METROX_AWS_REGION=us-east-1
METROX_CREDENTIAL_MIN_KEY_LENGTH=8
METROX_CREDENTIAL_ROTATION_MAX_AGE_DAYS=90
METROX_CREDENTIAL_ROTATION_ENFORCED=true
METROX_RUN_QUEUE_ENABLED=true
METROX_RUN_QUEUE_BACKEND=inprocess
METROX_RUN_WORKER_THREADS=1
METROX_RUN_QUEUE_MAX_RETRIES=2
METROX_RUN_QUEUE_RETRY_BACKOFF_S=0.5
METROX_RUN_QUEUE_REDIS_KEY=metrox:runs:queue
METROX_RUN_QUEUE_REDIS_DLQ_KEY=metrox:runs:dlq
METROX_RUN_QUEUE_REDIS_WORKERS_KEY=metrox:runs:workers
METROX_RUN_QUEUE_REDIS_BLOCK_S=5
METROX_RUN_QUEUE_WORKER_HEARTBEAT_TTL_S=60
METROX_RUN_BATCH_SIZE=100
VITE_API_BASE_URL=http://localhost:8000
VITE_API_KEY=local-dev-key
