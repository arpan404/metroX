AUTOREDTEAM_DATABASE_URL=postgresql+psycopg://autoredteam:autoredteam@localhost:5432/autoredteam
AUTOREDTEAM_API_KEY=local-dev-key
AUTOREDTEAM_REDIS_URL=redis://localhost:6379/0
AUTOREDTEAM_ALLOW_SYNTHETIC_TARGETS=true
AUTOREDTEAM_USE_MIGRATIONS=false
AUTOREDTEAM_SECRET_ACTIVE_KEY_VERSION=v1
# JSON map of key versions -> key material. Example: {"v1":"local-dev-secret","v2":"rotated-secret"}
AUTOREDTEAM_SECRET_KEYS_JSON=
AUTOREDTEAM_SECRET_BACKEND=local
AUTOREDTEAM_SECRET_BACKEND_STRICT=false
AUTOREDTEAM_AWS_KMS_KEY_ID=
AUTOREDTEAM_AWS_REGION=us-east-1
AUTOREDTEAM_CREDENTIAL_MIN_KEY_LENGTH=8
AUTOREDTEAM_CREDENTIAL_ROTATION_MAX_AGE_DAYS=90
AUTOREDTEAM_CREDENTIAL_ROTATION_ENFORCED=true
AUTOREDTEAM_RUN_QUEUE_ENABLED=true
AUTOREDTEAM_RUN_QUEUE_BACKEND=inprocess
AUTOREDTEAM_RUN_WORKER_THREADS=1
AUTOREDTEAM_RUN_QUEUE_MAX_RETRIES=2
AUTOREDTEAM_RUN_QUEUE_RETRY_BACKOFF_S=0.5
AUTOREDTEAM_RUN_QUEUE_REDIS_KEY=autoredteam:runs:queue
AUTOREDTEAM_RUN_QUEUE_REDIS_DLQ_KEY=autoredteam:runs:dlq
AUTOREDTEAM_RUN_QUEUE_REDIS_WORKERS_KEY=autoredteam:runs:workers
AUTOREDTEAM_RUN_QUEUE_REDIS_BLOCK_S=5
AUTOREDTEAM_RUN_QUEUE_WORKER_HEARTBEAT_TTL_S=60
AUTOREDTEAM_RUN_BATCH_SIZE=100
VITE_API_BASE_URL=http://localhost:8000
VITE_API_KEY=local-dev-key
